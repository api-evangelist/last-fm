                  "key": "artist",
                  "value": "<string>"
                },
                {
                  "description": "(Required) The album name.",
                  "key": "album",
                  "value": "<string>"
                },
                {
                  "description": "(Required) A comma delimited list of user supplied tags to apply to this album. Accepts a maximum of 10 tags.",
                  "key": "tags",
                  "value": "<string>"
                },
